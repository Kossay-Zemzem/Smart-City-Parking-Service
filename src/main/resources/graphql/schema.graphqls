# GraphiQL -> http://localhost:8083/graphiql?path=/graphql

type Query {
    spotById(id: ID): Spot #DONE
    etageById(id: ID): Etage #DONE
    emptySpots: [Etage] #DONE
    getAllEtages: [Etage] #DONE
    getAllResrervations: [ReservationData] #DONE
    getReservationsByRefClient(refClient: String): [ReservationData] #DONE
    spotByCode(codeSpot: String,labelEtage: String): Spot #DONE
    EtageByLabel(labelEtage: String): Etage #DONE
    #    closestEmptySpot: Spot #TODO 4
}
type Mutation {
    reserveSpot(Reservation: Reservation): Facture
}

enum ParkingSpotType {
    NORMAL,
    VIP
}

type Spot{
    id: ID
    code: String
    type: ParkingSpotType
    isOccupied: Boolean
}

type Etage{
    id: ID
    label: String
    capacity: Int
    hasPayementKiosk: Boolean
    spots: [Spot]
}

#TODO implement this , but will need to affect the entire reserveSpot chain in three serices
#type Parking{
#    id: ID
#    code: String
#    address: String
#    etat: EtatParking
#    etages: [Etage]
#}

type Facture{
    refFacture: String
    refClient: String
    spot: Spot
    etageLabel: String
    durationInHours: Int
    prixTTC: Float
}

input Reservation{
    spotCode: String
    etageLabel: String
    durationInHours: Int
    refClient: String
}

type ReservationData{
    spotCode: String
    etageLabel: String
    durationInHours: Int
    refClient: String
}