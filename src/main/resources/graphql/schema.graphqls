# GraphiQL -> http://localhost:8083/graphiql?path=/graphql

type Query {
    spotById(id: ID): Spot
    etageById(id: ID): Etage
    #Queries to be called by the orchestrator-------------------
    emptySpots: [Etage]
    getAllEtages: [Etage]
    getAllResrervations: [ReservationData]
    getReservationsByRefClient(refClient: String): [ReservationData]
    spotByCode(codeSpot: String,labelEtage: String): Spot
    EtageByLabel(labelEtage: String): Etage

    #    closestEmptySpot: Spot #TODO
}
type Mutation {
    reserveSpot(Reservation: Reservation): Facture
}

enum ParkingSpotType {
    NORMAL,
    VIP
}

type Spot{
    id: ID
    code: String
    type: ParkingSpotType
    isOccupied: Boolean
}

type Etage{
    id: ID
    label: String
    capacity: Int
    hasPaymentKiosk: Boolean
    spots: [Spot]
}

#TODO implement this , but will need to affect the entire reserveSpot chain in three serices
#type Parking{
#    id: ID
#    code: String
#    address: String
#    etat: EtatParking
#    etages: [Etage]
#}

type Facture{
    refFacture: String
    refClient: String
    spot: Spot
    etageLabel: String
    durationInHours: Int
    prixTTC: Float
}

input Reservation{
    spotCode: String
    etageLabel: String
    durationInHours: Int
    refClient: String
}

type ReservationData{
    spotCode: String
    etageLabel: String
    durationInHours: Int
    refClient: String
}