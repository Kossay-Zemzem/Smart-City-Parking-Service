# GraphiQL -> http://localhost:8080/graphiql?path=/graphql

type Query {
    spotById(id: ID): Spot
    etageById(id: ID): Etage
    emptySpots: [Etage]
#    closestEmptySpot: Spot
}
type Mutation {
    reserveSpot(Reservation: Reservation): Facture
}

enum ParkingSpotType {
    NORMAL,
    VIP
}
type Spot{
    id: ID
    code: String
    type: ParkingSpotType
    isOccupied: Boolean
}

type Etage{
    id: ID
    label: String
    capacity: Int
    hasPayementKiosk: Boolean
    spots: [Spot]
}

type Facture{
    refFacture: String
    refClient: String
    spot: Spot
    etageLabel: String
    durationInHours: Int
    prixTTC: Float
}

input Reservation{
    spotCode: String
    etageLabel: String
    durationInHours: Int
    refClient: String
}